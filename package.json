{
  "name": "quire-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm --workspace examples/basic run build",
    "check": "npm run build && node scripts/check-styles.mjs && node scripts/check-license.mjs",
    "check:browser": "npm run build && node scripts/check-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
