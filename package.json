{
  "name": "@d0ssant0s/quire",
  "version": "0.2.1",
  "private": true,
  "description": "The look and feel and the components for technical-documentation sites built with Astro and Tailwind",
  "license": "MIT",
  "author": "d0ssant0s",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0ssant0s/quire.git"
  },
  "keywords": [
    "astro-integration",
    "documentation",
    "tailwindcss"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./styles/tokens.css",
    "./theme.css": "./styles/theme.css",
    "./prose.css": "./styles/prose.css",
    "./components/*": "./src/components/*",
    "./vue/*": "./src/vue/*"
  },
  "files": [
    "src",
    "styles",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "npm --workspace examples/basic run build",
    "check": "npm run check:references && npm run build && node scripts/check-styles.mjs && node scripts/check-license.mjs",
    "check:references": "node --test scripts/check-references.test.mjs && node scripts/check-references.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "check:browser": "npm run build && node scripts/check-browser.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "astro": "^7.4.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "reka-ui": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
