---
// The page header: a menu button for the sidebar, the site's own content, and
// the theme switch. The default slot holds the site's name and links; the `end`
// slot holds controls such as search, before the theme switch. A skip link to
// <main> comes first of all, so it is the first stop for a keyboard. Put the
// header in Page's `header` slot to frame it beside a full-height sidebar;
// mark the site's name `data-quire-brand` there, and Page hides it while the
// sidebar shows the same name above its navigation. The header draws no
// bottom edge: the page beneath it has the same background.
import IconButton from './IconButton.astro';
import SkipLink from './SkipLink.astro';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  /** Show the menu button; set it on pages whose shell has a sidebar. */
  menu?: boolean;
  /** Prefix of the localStorage keys; must match ThemeScript's. */
  storage?: string;
  class?: string;
  /** The skip link's text; `false` leaves the link out. */
  skip?: string | false;
  /** The id of <main> the skip link leads to; match Page's `main.id`. */
  skipTo?: string;
}
const { menu = false, storage = 'quire', class: className, skip = 'Skip to content', skipTo = 'quire-main' } = Astro.props;
---

{skip && <SkipLink text={skip} target={skipTo} />}
<header class:list={['sticky top-0 z-30 flex h-(--quire-header) items-center gap-3 bg-bg px-4', className]}>
  {menu && (
    <IconButton data-quire-menu data-quire-storage={storage} aria-controls="quire-sidebar" aria-expanded="false" aria-label="Navigation">
      <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4h11M2.5 8h11M2.5 12h11" /></svg>
    </IconButton>
  )}
  <slot />
  <span class="flex-1"></span>
  <slot name="end" />
  <ThemeSwitch storage={storage} />
</header>

<script>
  // On a wide screen the button collapses the sidebar and remembers it; on a
  // narrow one it slides the sidebar over the page until the reader closes it.
  const root = document.documentElement;
  const wide = matchMedia('(min-width: 64rem)');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-quire-menu]')];
  const sync = () => {
    const open = wide.matches ? !root.hasAttribute('data-sidebar-collapsed') : root.hasAttribute('data-sidebar-open');
    for (const button of buttons) button.setAttribute('aria-expanded', String(open));
  };
  const close = () => {
    root.removeAttribute('data-sidebar-open');
    sync();
  };
  for (const button of buttons) {
    button.addEventListener('click', () => {
      if (wide.matches) {
        const collapsed = root.toggleAttribute('data-sidebar-collapsed');
        try {
          localStorage.setItem(`${button.dataset.quireStorage}-sidebar`, collapsed ? 'collapsed' : '');
        } catch {
          // The choice then lasts only for this page.
        }
      } else {
        root.toggleAttribute('data-sidebar-open');
      }
      sync();
    });
  }
  document.querySelector('[data-quire-scrim]')?.addEventListener('click', close);
  addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !root.hasAttribute('data-sidebar-open')) return;
    close();
    buttons[0]?.focus();
  });
  wide.addEventListener('change', close);
  sync();

  // Focus follows the sidebar on a narrow screen, whatever opens or closes it:
  // in to the current page's link on opening, and back to the menu button on
  // closing if focus was in the sidebar. A click on the scrim drops focus on
  // the page first, so focus on the body counts as the sidebar's too.
  const sidebar = document.querySelector<HTMLElement>('[data-quire-sidebar]');
  if (sidebar && buttons.length) {
    const focusIn = () => {
      const link = sidebar.querySelector<HTMLElement>('[aria-current=page]') ?? sidebar.querySelector<HTMLElement>('a, summary');
      link?.focus({ preventScroll: true });
    };
    const focusBack = () => {
      const held = sidebar.contains(document.activeElement) || document.activeElement === document.body;
      if (held) buttons[0].focus();
    };
    new MutationObserver(() => {
      if (wide.matches) return;
      if (root.hasAttribute('data-sidebar-open')) focusIn();
      else focusBack();
    }).observe(root, { attributes: true, attributeFilter: ['data-sidebar-open'] });
  }
</script>
