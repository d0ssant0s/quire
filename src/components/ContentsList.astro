---
// One level of the contents tree; Contents renders the first. A heading with
// headings under it is a branch with a toggle, closed until opened. Rows use
// the sidebar's row style and indent by heading level.
import type { Branch } from './contents';
import { navIndent, navLabel, navRow, navRowCurrent } from './nav-row';

interface Props { nodes: Branch[] }
const { nodes } = Astro.props;
---

{nodes.map((node) => (
  <li data-quire-branch={node.children.length ? '' : undefined}>
    <div class="flex items-center gap-px">
      <a
        href={`#${node.slug}`}
        title={node.text}
        data-level={node.level}
        class:list={[navRow, navRowCurrent, navIndent, 'flex-1 text-muted']}
      ><span class={navLabel}>{node.text}</span></a>
      {node.children.length > 0 && (
        <button
          type="button"
          class="group flex size-[32px] shrink-0 cursor-pointer items-center justify-center rounded-[6px] text-faint hover:bg-subtle hover:text-fg"
          aria-expanded="false"
          aria-controls={`quire-contents-${node.slug}`}
          aria-label={`Contents of ${node.text}`}
        >
          <svg class="size-[14px] -rotate-90 transition-transform group-aria-expanded:rotate-0 motion-reduce:transition-none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
        </button>
      )}
    </div>
    {node.children.length > 0 && (
      <ul id={`quire-contents-${node.slug}`} class="mt-px flex flex-col gap-px" hidden>
        <Astro.self nodes={node.children} />
      </ul>
    )}
  </li>
))}
