---
// A square button holding one icon, as the header's controls use.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'button'>;
const { class: className, ...attributes } = Astro.props;
---

<button type="button" {...attributes} class:list={['grid size-[32px] shrink-0 cursor-pointer place-items-center rounded-lg border border-line bg-surface text-muted hover:text-fg', className]}><slot /></button>
