---
// The page shell: the section sidebar, the article and the contents rail. The
// sidebar and rail columns exist only when their slots render something, so a
// site may fill them conditionally; `wide` gives the article the whole width
// and drops the rail, for tables and graphs. On a desktop the sidebar is a
// column the menu button collapses; on a phone it slides over the page. The
// rail appears once there is room for it. <main> has an id (`quire-main`
// unless `main.id` says otherwise) for Header's skip link, and takes focus
// without a ring. The sidebar and the rail scroll in their own boxes and keep
// a wheel or swipe at their ends from moving the page; the article scrolls the
// window, with the header held at its top, and neither panel moves while it
// does, from the top of the article to its end, whatever follows the shell. The
// panels stay in the window to the page's end, so the sidebar covers the left
// of anything after the shell; a footer that must be read whole belongs inside
// the article.
//
// A Header in the `header` slot is framed: on a desktop the sidebar runs the
// window's full height on its own surface and the header starts at its edge,
// as two panes. The `brand` slot, usually the site's name, heads the sidebar
// there, and the header's own `data-quire-brand` element steps aside while
// the sidebar shows; a collapsed sidebar gives the header both back. A Header
// placed before Page instead spans the window above the shell.
//
// On a desktop a handle on the sidebar's edge resizes it: dragged, or with the
// arrow keys once focused, between 208px and what leaves the article 640px.
// A double-click or Enter returns it to its standard width. The width is kept
// under `<storage>-sidebar-width`, which ThemeScript restores before paint.
import type { HTMLAttributes } from 'astro/types';

interface Props {
  wide?: boolean;
  /** Classes for the shell, such as a maximum width. */
  class?: string;
  /** Attributes for the <main> element, such as a search indexer's markers. */
  main?: HTMLAttributes<'main'>;
  /** Prefix of the localStorage keys; must match ThemeScript's. */
  storage?: string;
}
const { wide = false, class: className, main = {}, storage = 'quire' } = Astro.props;
// The main prop's class joins quire's own; spread as it is, it would be a
// second class attribute, and the browser keeps only the first.
const { class: mainClass, id: mainId = 'quire-main', ...mainAttributes } = main;
// Astro counts a slot as filled when its content is conditional and renders
// nothing, so a column is decided by what the slot renders.
const filled = async (name: string) => (Astro.slots.has(name) ? (await Astro.slots.render(name)).trim() : '');
const sidebarHtml = await filled('sidebar');
const railHtml = wide ? '' : await filled('rail');
const sidebar = sidebarHtml !== '';
const rail = railHtml !== '';
const framed = Astro.slots.has('header');
const brand = framed && sidebar && Astro.slots.has('brand');
const frame = [sidebar && 'sidebar', brand && 'brand'].filter(Boolean).join(' ');
const columns = sidebar
  ? rail
    ? 'lg:grid-cols-[var(--quire-sidebar-width)_minmax(0,1fr)] xl:grid-cols-[var(--quire-sidebar-width)_minmax(0,1fr)_248px] lg:sidebar-collapsed:grid-cols-[minmax(0,1fr)] xl:sidebar-collapsed:grid-cols-[minmax(0,1fr)_248px]'
    : 'lg:grid-cols-[var(--quire-sidebar-width)_minmax(0,1fr)] lg:sidebar-collapsed:grid-cols-[minmax(0,1fr)]'
  : rail
    ? 'xl:grid-cols-[minmax(0,1fr)_248px]'
    : '';
// The panels do not count towards the shell's height (see `hold`), so the shell
// keeps the least height they gave it: a short article leaves whatever follows
// the shell below the panels' foot, as it did when they sized the shell.
const height = sidebar
  ? rail
    ? 'lg:min-h-[calc(100vh-var(--quire-header))] lg:sidebar-collapsed:min-h-0 xl:sidebar-collapsed:min-h-[calc(100vh-var(--quire-header))]'
    : 'lg:min-h-[calc(100vh-var(--quire-header))] lg:sidebar-collapsed:min-h-0'
  : rail
    ? 'xl:min-h-[calc(100vh-var(--quire-header))]'
    : '';
// overscroll-y-contain keeps a wheel or swipe at the end of either box from
// scrolling the page behind it.
const side = 'top-(--quire-header) h-[calc(100vh-var(--quire-header))] overflow-y-auto overscroll-y-contain';
// A sticky box may not leave its grid area, and the area ends with the shell, so
// anything after the shell, such as a footer or the fraction a page's height
// rounds away, would push the panel up once the article ends. A bottom margin
// of the window's height puts the end of the box the grid holds the panel in
// above the panel's own foot, so the panel stays at the window's top until the
// page itself ends. The margin sits on the panel, whose own height it leaves
// alone. Below lg the sidebar is fixed and needs none.
const hold = '-mb-[100vh]';
// Framed, the desktop sidebar rises into the header's row and fills the window.
const fullHeight = 'lg:top-0 lg:-mt-(--quire-header) lg:h-screen';
// Below lg the sidebar slides over the page. Closed, it is hidden as well as
// moved away, so its links leave the tab order; the hiding waits for the slide
// out to finish, and showing it is immediate so focus can move straight in.
const drawer = [
  'fixed left-0 z-25 w-[min(300px,86vw)] -translate-x-full invisible bg-sidebar',
  'motion-safe:[transition:translate_180ms,visibility_0s_180ms]',
  'sidebar-open:visible sidebar-open:translate-x-0 sidebar-open:shadow-xl motion-safe:sidebar-open:[transition:translate_180ms]',
];
// The sidebar and its resize handle share the first cell, so the handle sits on
// the sidebar's edge.
const column = 'lg:-mb-[100vh] lg:col-start-1 lg:row-start-1 lg:visible lg:sticky lg:z-auto lg:w-auto lg:translate-x-0 lg:border-r lg:border-line lg:transition-none lg:sidebar-open:shadow-none lg:sidebar-collapsed:hidden';
---

<div data-quire-frame={framed ? frame : undefined} class="contents">
  {framed && <slot name="header" />}
  <div data-quire-shell class:list={['grid grid-cols-[minmax(0,1fr)]', columns, height, className]}>
    {sidebar && (
      <div
        id="quire-sidebar"
        data-quire-sidebar
        class:list={[side, drawer, column, framed && fullHeight]}
      >
        {brand && (
          <div data-quire-sidebar-brand class="sticky top-0 z-1 hidden h-(--quire-header) items-center gap-2 bg-sidebar px-[20px] lg:flex"><slot name="brand" /></div>
        )}
        <Fragment set:html={sidebarHtml} />
      </div>
    )}
    {sidebar && (
      <div
        data-quire-resize
        data-quire-storage={storage}
        role="separator"
        aria-orientation="vertical"
        aria-controls="quire-sidebar"
        aria-label="Resize navigation"
        tabindex="0"
        class:list={[
          'group sticky top-(--quire-header) lg:-mb-[100vh] z-40 hidden h-[calc(100vh-var(--quire-header))] w-2 translate-x-1/2 cursor-col-resize touch-none justify-self-end focus:outline-none lg:col-start-1 lg:row-start-1 lg:block lg:sidebar-collapsed:hidden',
          framed && fullHeight,
        ]}
      ><span class="absolute inset-y-0 left-1/2 w-[2px] -translate-x-1/2 group-hover:bg-line-strong group-focus-visible:bg-accent group-data-dragging:bg-accent"></span></div>
    )}
    {sidebar && <div data-quire-scrim class="fixed inset-x-0 top-(--quire-header) bottom-0 z-24 hidden bg-black/30 sidebar-open:block lg:sidebar-open:hidden"></div>}
    <main
      {...mainAttributes}
      id={mainId}
      tabindex="-1"
      data-quire-main
      class:list={['w-full min-w-0 justify-self-center px-5 pt-7 pb-24 focus:outline-none md:px-12', wide ? 'max-w-none' : 'max-w-[980px]', mainClass]}
    ><slot /></main>
    {rail && <div data-quire-rail class:list={[side, hold, 'sticky hidden p-[12px] xl:block']}><Fragment set:html={railHtml} /></div>}
  </div>
</div>

<script>
  // The handle sets --quire-sidebar-width on the root, which the grid, the
  // framed header and ThemeScript all read. The CSS clamp keeps the width in
  // bounds as the window changes; the script clamps only what it reports.
  const root = document.documentElement;
  const handle = document.querySelector<HTMLElement>('[data-quire-resize]');
  const sidebar = document.getElementById('quire-sidebar');
  if (handle && sidebar) {
    const key = `${handle.dataset.quireStorage}-sidebar-width`;
    const least = 208;
    const most = () => Math.max(least, innerWidth - 640);
    const clamp = (width: number) => Math.round(Math.min(most(), Math.max(least, width)));
    const width = () => Math.round(sidebar.getBoundingClientRect().width);
    const report = () => {
      handle.setAttribute('aria-valuemin', String(least));
      handle.setAttribute('aria-valuemax', String(most()));
      handle.setAttribute('aria-valuenow', String(width()));
    };
    const set = (value: number) => root.style.setProperty('--quire-sidebar-width', `clamp(${least}px, ${value}px, max(${least}px, 100vw - 640px))`);
    const keep = () => {
      try {
        localStorage.setItem(key, String(width()));
      } catch {
        // The width then lasts only for this page.
      }
      report();
    };
    const reset = () => {
      root.style.removeProperty('--quire-sidebar-width');
      try {
        localStorage.removeItem(key);
      } catch {
        // Nothing was kept.
      }
      report();
    };

    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      // No text selection while dragging.
      event.preventDefault();
      handle.setPointerCapture(event.pointerId);
      handle.dataset.dragging = '';
      const start = event.clientX;
      const from = width();
      const move = (moved: PointerEvent) => set(clamp(from + moved.clientX - start));
      handle.addEventListener('pointermove', move);
      handle.addEventListener('lostpointercapture', () => {
        handle.removeEventListener('pointermove', move);
        delete handle.dataset.dragging;
        if (width() !== from) keep();
      }, { once: true });
    });
    handle.addEventListener('dblclick', reset);
    handle.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? 64 : 16;
      const to = { ArrowLeft: width() - step, ArrowRight: width() + step, Home: least, End: most() }[event.key];
      if (event.key === 'Enter') reset();
      else if (to === undefined) return;
      else {
        set(clamp(to));
        keep();
      }
      event.preventDefault();
    });
    addEventListener('resize', report);
    report();
  }
</script>
