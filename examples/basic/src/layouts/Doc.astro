---
import type { MarkdownHeading } from 'astro';
import type { NavItem } from '@d0ssant0s/quire';
import Contents from '@d0ssant0s/quire/components/Contents.astro';
import Header from '@d0ssant0s/quire/components/Header.astro';
import Page from '@d0ssant0s/quire/components/Page.astro';
import Sidebar from '@d0ssant0s/quire/components/Sidebar.astro';
import ThemeScript from '@d0ssant0s/quire/components/ThemeScript.astro';
import Search from '@d0ssant0s/quire/vue/Search.vue';
import '../styles/site.css';

interface Props { frontmatter: { title: string }; headings: MarkdownHeading[] }
const { frontmatter, headings } = Astro.props;
// Icons are the site's own SVG markup; quire ships none.
const svg = (path: string) => `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="${path}"/></svg>`;
// A long group above the current page, so the sidebar has to scroll to it.
const topics: NavItem[] = Array.from({ length: 30 }, (_, index) => ({ label: `Topic ${index + 1}`, href: `/topics/${index + 1}/` }));
const sections: NavItem[] = [
  { label: 'Home', href: '/', icon: svg('M2.5 7.5 8 3l5.5 4.5V13h-11Z') },
  { label: 'Reference', icon: svg('M3 2.5h10v11H3ZM5.5 5.5h5M5.5 8h5'), items: topics },
  { label: 'Reading', icon: svg('M2.5 3.5h4.5v9H2.5ZM9 3.5h4.5v9H9Z'), items: [{ label: 'Guide', href: '/guide/' }, { label: 'Short note', href: '/note/' }] },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} · quire example</title>
    <ThemeScript />
  </head>
  <body class="min-h-screen bg-bg text-fg">
    <Header menu>
      <a href="/" class="font-semibold">quire example</a>
      <Search slot="end" client:idle endpoint="/api/search" />
    </Header>
    <Page class="mx-auto max-w-[1480px]">
      <Sidebar slot="sidebar" items={sections} current={Astro.url.pathname} />
      <h1 class="text-[30px] font-semibold">{frontmatter.title}</h1>
      <article class="quire-prose mt-7"><slot /></article>
      {headings.length > 0 && <Contents slot="rail" headings={headings} tree />}
    </Page>
  </body>
</html>
