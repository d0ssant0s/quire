---
// A page with only the header, for pages that show one thing in it.
import Header from '@d0ssant0s/quire/components/Header.astro';
import ThemeScript from '@d0ssant0s/quire/components/ThemeScript.astro';
import '../styles/site.css';

interface Props { title: string }
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · quire example</title>
    <ThemeScript />
  </head>
  <body class="min-h-screen bg-bg text-fg">
    <Header>
      <a href="/" class="font-semibold">quire example</a>
      <slot name="end" slot="end" />
    </Header>
    <main class="mx-auto max-w-2xl p-8">
      <h1 class="text-xl font-semibold">{title}</h1>
      <slot />
    </main>
  </body>
</html>
